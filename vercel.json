{
  "buildCommand": "npm run build",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/server.js"
    },
    {
      "source": "/(.*)",
      "destination": "/dist/client/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/dist/client/index.html"
    }
  ]
}
