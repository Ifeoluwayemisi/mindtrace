# MindTrace environment template
# Copy this file to .env and replace placeholders with local, private values.
NODE_ENV=development
PORT=3000

# Server-controlled hackathon/demo option. Enables authenticated teacher workspace
# access without accreditation approval. Never enable in production.
MINDTRACE_DEMO_MODE=false

# Neon PostgreSQL. For local development, the current server selects its SQLite
# development database when NODE_ENV is not production; migrations target Postgres.
DATABASE_URL="postgres://user:password@ep-example-pooler.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgres://user:password@ep-example-direct.neon.tech/neondb?sslmode=require"

# Server-only secrets; generate unique values and never add VITE_ prefixes.
SESSION_SECRET="replace-with-a-long-random-secret"
ARGON2_PEPPER="replace-with-a-long-random-secret"

# Optional server-only Google Gemini key. Without it, the deterministic
# explanation fallback remains available.
GEMINI_API_KEY=""
